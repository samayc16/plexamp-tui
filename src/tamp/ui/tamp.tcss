Screen {
    background: #2d2a2e;
    color: #fcfcfa;
}

#body {
    height: 1fr;
}

#nav {
    width: 21;
    height: 1fr;
    border: none;
    border-right: solid #403e41;
    background: #2d2a2e;
    padding: 1 0;
}

#center {
    width: 1fr;
}

#crumb {
    height: 1;
    margin: 1 0 0 1;
}

#search {
    margin: 0 1;
    border: round #ffd866;
}

#browser {
    height: 1fr;
    border: none;
    background: #2d2a2e;
    padding: 0 1;
}

#lyrics {
    height: 1fr;
    padding: 1 2;
}

#np {
    width: 42;
    border-left: solid #403e41;
    padding: 1 1 0 2;
}

#np-art {
    height: auto;
    margin-bottom: 1;
}

#np-info, #np-progress, #np-status {
    height: auto;
}

#np-progress {
    margin: 1 0;
}

#np-below {
    margin-top: 1;
    height: 1fr;
}

#hint {
    height: 1;
    dock: bottom;
    offset-y: -1;
    width: auto;
    background: transparent;
}

OptionList > .option-list--option-highlighted {
    background: #403e41;
}

OptionList:focus > .option-list--option-highlighted {
    background: #5b595c;
}

#signin, #pick {
    align: center middle;
    width: 100%;
    height: 1fr;
    padding: 2 4;
}

#signin-title, #pick-title {
    margin-bottom: 1;
}

#signin-steps {
    margin-bottom: 1;
}

#signin-qr {
    width: auto;
}

#signin-status {
    margin-top: 1;
}

#pick-list {
    height: auto;
    max-height: 20;
    border: round #403e41;
    margin-top: 1;
}

PinScreen, Prompt, Choose {
    align: center middle;
}

#pin, #prompt, #choose {
    width: 56;
    height: auto;
    border: round #ffd866;
    background: #221f22;
    padding: 1 2;
}

#choose-list {
    height: auto;
    max-height: 16;
    border: none;
    margin-top: 1;
}

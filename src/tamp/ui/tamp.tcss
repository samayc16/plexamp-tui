/* colours are theme roles ($t-*), see ui/theme.py */
Screen {
    background: $t-bg;
    color: $t-fg;
}

#topbar {
    width: 100%;
    height: 1;
    background: $t-panel;
}

#body {
    height: 1fr;
}

#nav {
    width: 21;
    height: 1fr;
    border: none;
    border-right: solid $t-line;
    background: $t-bg;
    padding: 1 0;
}

#center {
    width: 1fr;
}

#page-header {
    height: 7;
    margin: 1 1 0 1;
}

#page-art {
    width: 14;
}

#page-meta {
    width: 1fr;
    padding: 0 1;
}

#crumb {
    height: 1;
    margin: 1 0 0 1;
}

#search {
    margin: 0 1;
    border: round $t-highlight;
}

#browser {
    height: 1fr;
    border: none;
    background: $t-bg;
    padding: 0 1;
}

#lyrics {
    height: 1fr;
    padding: 1 2;
}

#np {
    width: 42;
    background: $t-bg;  /* explicit, so pop-ups dim it evenly */
    border-left: solid $t-line;
    padding: 1 1 0 2;
}

#np-art {
    height: auto;
    margin-bottom: 1;
}

#np-info, #np-status {
    height: auto;
}

#np-progress {
    height: 1;
    margin: 1 0;
}

#np-below {
    margin-top: 1;
    height: 1fr;
}

OptionList > .option-list--option-highlighted {
    background: $t-line;
}

OptionList:focus > .option-list--option-highlighted {
    background: $t-select;
}

OptionList > .option-list--option-hover {
    background: $t-hover;
}

/* first run */
#signin, #pick {
    align: center middle;
    width: 100%;
    height: 1fr;
    padding: 2 4;
}

#signin-title, #pick-title {
    margin-bottom: 1;
}

#signin-steps {
    margin-bottom: 1;
}

#signin-qr {
    width: auto;
}

#signin-status {
    margin-top: 1;
}

#pick-list {
    height: auto;
    max-height: 20;
    border: round $t-line;
    margin-top: 1;
}

/* pop-ups */
PinScreen, Prompt, Choose, HelpScreen, InfoScreen {
    align: center middle;
    background: $t-overlay 60%;
}

ContextMenu {
    background: $t-overlay 30%;
}

#menu {
    height: auto;
    border: round $t-accent;
    border-title-color: $t-accent;
    border-title-style: bold;
    background: $t-panel;
    padding: 0;
}

#menu-list {
    height: auto;
    border: none;
    background: $t-panel;
    padding: 0;
}

#pin, #prompt, #choose {
    width: 56;
    height: auto;
    border: round $t-highlight;
    background: $t-panel;
    padding: 1 2;
}

#choose-list {
    height: auto;
    max-height: 16;
    border: none;
    margin-top: 1;
}

#help {
    width: 90%;
    max-width: 110;
    height: 85%;
    border: round $t-accent;
    background: $t-panel;
    padding: 1 2;
}

#help-filter {
    margin: 1 0;
    border: round $t-line;
}

#info {
    width: 64;
    height: auto;
    border: round $t-album;
    background: $t-panel;
    padding: 1 2;
}

#info-art {
    margin: 1 0;
}

/* full-screen player (F) */
#fp {
    height: 1fr;
    padding: 1 2;
}

#fp-left {
    width: 1fr;
    max-width: 70;
    padding-right: 3;
}

#fp-art {
    height: auto;
    margin-bottom: 1;
}

#fp-info, #fp-status {
    height: auto;
}

#fp-progress {
    height: 1;
    margin: 1 0;
}

#fp-lyrics {
    width: 1fr;
    height: 1fr;
    padding: 2 2 0 2;
    border-left: solid $t-line;
}

#fp-hint {
    height: 1;
    dock: bottom;
}

#loading {
    align: center middle;
    height: 1fr;
}

#loading LoadingIndicator {
    height: 3;
    color: $t-accent;
}

/* scrollbars in the palette, not Textual's default blue */
* {
    scrollbar-background: $t-bg;
    scrollbar-background-hover: $t-bg;
    scrollbar-background-active: $t-bg;
    scrollbar-color: $t-select;
    scrollbar-color-hover: $t-dim;
    scrollbar-color-active: $t-accent;
    scrollbar-corner-color: $t-bg;
}

#np > * {
    background: $t-bg;
}

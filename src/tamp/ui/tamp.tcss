/* Monokai Pro */
Screen {
    background: #2d2a2e;
    color: #fcfcfa;
}

#topbar {
    height: 1;
    background: #221f22;
}

#body {
    height: 1fr;
}

#nav {
    width: 21;
    height: 1fr;
    border: none;
    border-right: solid #403e41;
    background: #2d2a2e;
    padding: 1 0;
}

#center {
    width: 1fr;
}

#page-header {
    height: 7;
    margin: 1 1 0 1;
}

#page-art {
    width: 14;
}

#page-meta {
    width: 1fr;
    padding: 0 1;
}

#crumb {
    height: 1;
    margin: 1 0 0 1;
}

#search {
    margin: 0 1;
    border: round #ffd866;
}

#browser {
    height: 1fr;
    border: none;
    background: #2d2a2e;
    padding: 0 1;
}

#lyrics {
    height: 1fr;
    padding: 1 2;
}

#np {
    width: 42;
    border-left: solid #403e41;
    padding: 1 1 0 2;
}

#np-art {
    height: auto;
    margin-bottom: 1;
}

#np-info, #np-status {
    height: auto;
}

#np-progress {
    height: 1;
    margin: 1 0;
}

#np-below {
    margin-top: 1;
    height: 1fr;
}

OptionList > .option-list--option-highlighted {
    background: #403e41;
}

OptionList:focus > .option-list--option-highlighted {
    background: #5b595c;
}

OptionList > .option-list--option-hover {
    background: #363337;
}

/* first run */
#signin, #pick {
    align: center middle;
    width: 100%;
    height: 1fr;
    padding: 2 4;
}

#signin-title, #pick-title {
    margin-bottom: 1;
}

#signin-steps {
    margin-bottom: 1;
}

#signin-qr {
    width: auto;
}

#signin-status {
    margin-top: 1;
}

#pick-list {
    height: auto;
    max-height: 20;
    border: round #403e41;
    margin-top: 1;
}

/* pop-ups */
PinScreen, Prompt, Choose, HelpScreen, InfoScreen {
    align: center middle;
    background: #19181a 60%;
}

ContextMenu {
    background: #19181a 30%;
}

#menu {
    height: auto;
    border: round #ff6188;
    border-title-color: #ff6188;
    border-title-style: bold;
    background: #221f22;
    padding: 0;
}

#menu-list {
    height: auto;
    border: none;
    background: #221f22;
    padding: 0;
}

#pin, #prompt, #choose {
    width: 56;
    height: auto;
    border: round #ffd866;
    background: #221f22;
    padding: 1 2;
}

#choose-list {
    height: auto;
    max-height: 16;
    border: none;
    margin-top: 1;
}

#help {
    width: 90%;
    max-width: 110;
    height: 85%;
    border: round #ff6188;
    background: #221f22;
    padding: 1 2;
}

#help-filter {
    margin: 1 0;
    border: round #403e41;
}

#info {
    width: 64;
    height: auto;
    border: round #78dce8;
    background: #221f22;
    padding: 1 2;
}

#info-art {
    margin: 1 0;
}

/* full-screen player (F) */
#fp {
    height: 1fr;
    padding: 1 2;
}

#fp-left {
    width: 1fr;
    max-width: 70;
    padding-right: 3;
}

#fp-art {
    height: auto;
    margin-bottom: 1;
}

#fp-info, #fp-status {
    height: auto;
}

#fp-progress {
    height: 1;
    margin: 1 0;
}

#fp-lyrics {
    width: 1fr;
    height: 1fr;
    padding: 2 2 0 2;
    border-left: solid #403e41;
}

#fp-hint {
    height: 1;
    dock: bottom;
}

#loading {
    align: center middle;
    height: 1fr;
}

#loading LoadingIndicator {
    height: 3;
    color: #ff6188;
}
